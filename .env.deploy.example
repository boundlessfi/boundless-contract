# Deployment configuration for scripts/deploy/deploy.sh (testnet, futurenet).
# Copy to .env.deploy before running it.
#
# .env.deploy is gitignored (see .gitignore). NEVER commit a populated file.

# Stellar CLI identity that deploys both contracts and holds admin on them.
# Create with: stellar keys generate <name> --network testnet --fund
ADMIN_IDENTITY=boundless-admin

# G-address that receives the platform fee on every deposit. It needs an
# authorized trustline for every token you register.
FEE_ACCOUNT=

# Platform fee in basis points (100 = 1%, 250 = 2.5%). Range 0..1000; the
# contract caps fees at 1000 (10%).
FEE_BPS=250
